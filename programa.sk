var limite : int = 20;
var soma = 0;
var encontrou = false;

for i in range(0, limite){
    switch(i % 3):
        case 0: {
            var dobro = i * 2;
            soma = soma + dobro;
        }
        case 1: {
            if(soma > 50){
                break;
            }
        }
        default: {
            soma = soma + i;
        }
}

outl(soma);

var x = 0;
var resultado = 1;

do {
    for j in range(1, 5){
        if(j == 3){
            continue;
        }
        resultado = resultado * j;
    }
    x++;
} while(x < 3);

outl(resultado);

for a in range(0, 10){
    for b in range(0, 10){
        if(a == b){
            continue;
        }
        if(a + b == 9){
            break 2;
        }
    }
}

outl(a);
